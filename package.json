{
  "name": "@nauverse/make-url",
  "description": "A tiny, dependency-free URL builder for TypeScript and JavaScript: path params, query params, hash, protocols and slashes handled for you.",
  "author": {
    "name": "Albert Adler | @albertadler",
    "url": "https://albertadler.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/TheNaubit/make-url#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheNaubit/make-url.git"
  },
  "bugs": {
    "url": "https://github.com/TheNaubit/make-url/issues"
  },
  "keywords": [
    "url",
    "builder",
    "querystring",
    "url-builder",
    "query-string",
    "uri",
    "build",
    "concat",
    "concatenate",
    "urlcat"
  ],
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/make-url.umd.cjs",
  "module": "./dist/make-url.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/make-url.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/make-url.umd.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "husky": "9.1.7",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.14.0 || >=24.10.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "warn"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
